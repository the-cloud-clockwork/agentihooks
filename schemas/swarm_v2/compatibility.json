{
  "schema": "swarm-v2-contracts/1",
  "package": "SV2-FND-03",
  "minors": {
    "2.0": "Plan section 22 baseline",
    "2.1": "Adds the optional trace_id correlation field"
  },
  "rules": [
    "A reader accepts a record whose major equals the contract major and whose minor is at least oldest_minor; a newer minor is additive and accepted.",
    "Authority fields live only in the closed authority object; an authority name outside it, or an unknown name inside it, is refused.",
    "Every record names execution_id, task_id and task_generation in its authority, except the error envelope.",
    "A relay keeps unknown optional fields byte for byte on read, modify and write.",
    "A consumer vendors these schema files and validates with a JSON Schema 2020-12 validator; it never imports the owner's runtime package.",
    "Schemas reference only urn:swarm-v2 identifiers inside this directory.",
    "Rollback lowers write_minor so producers write the previous minor while readers keep accepting both."
  ],
  "contracts": {
    "launch": {
      "schema": "launch.json",
      "owner": "agentihooks",
      "consumers": [
        "agentihooks"
      ],
      "major": 2,
      "oldest_minor": 0,
      "current_minor": 1,
      "write_minor": 1,
      "authority": [
        "execution_id",
        "task_id",
        "task_generation",
        "controller_epoch",
        "swarm_id",
        "seat_id",
        "grant_ref",
        "project_id"
      ],
      "extension": [
        "trace_id",
        "extensions"
      ]
    },
    "heartbeat": {
