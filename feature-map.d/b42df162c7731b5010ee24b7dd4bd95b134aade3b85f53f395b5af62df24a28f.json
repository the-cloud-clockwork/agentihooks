    "tests/ci_lab/test_scheduler_cache.py::test_a_small_invalid_generation_is_reset_without_touching_external_targets",
    "tests/ci_lab/test_scheduler_cache.py::test_one_byte_is_valid_but_too_small_for_the_cache_metadata",
    "tests/ci_lab/test_scheduler_cache.py::test_foreign_allocated_data_can_refuse_start_but_is_never_deleted",
    "tests/ci_lab/test_scheduler_cache.py::test_owned_entries_with_foreign_uid_metadata_refuse_before_start",
    "tests/ci_lab/test_scheduler_cache.py::test_stale_generations_with_foreign_uid_metadata_are_preserved",
