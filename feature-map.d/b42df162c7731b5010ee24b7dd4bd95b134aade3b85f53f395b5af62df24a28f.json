    "tests/ci_lab/test_scheduler_cache.py::test_unsafe_owned_entries_refuse_without_following_symlinks",
    "tests/ci_lab/test_scheduler_cache.py::test_logging_failure_cannot_prevent_invalid_marker_or_termination",
    "tests/ci_lab/test_scheduler_cache.py::test_unmarked_excess_is_reset_before_restart_consumers",
    "tests/ci_lab/test_scheduler_cache.py::test_startup_measurement_failure_refuses_before_consumers",
    "tests/ci_lab/test_scheduler_cache.py::test_invalid_marker_failure_still_terminates",
    "tests/ci_lab/test_scheduler_cache.py::test_monitor_shutdown_failure_terminates_before_releasing_ownership",
    "tests/ci_lab/test_scheduler_cache.py::test_an_interrupted_empty_root_with_only_its_lock_can_restart",
