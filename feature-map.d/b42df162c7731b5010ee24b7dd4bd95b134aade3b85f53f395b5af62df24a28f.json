    "tests/ci_lab/test_scheduler_cache.py::test_directory_walk_errors_propagate_but_vanished_directories_do_not_hide_siblings",
    "tests/ci_lab/test_scheduler_cache.py::test_allocated_bytes_refuses_a_symlink_as_its_root",
    "tests/ci_lab/test_scheduler_cache.py::test_main_policy_refusals_name_the_failed_setting",
    "tests/ci_lab/test_scheduler_cache.py::test_a_lock_without_write_access_refuses_before_consumers",
    "tests/ci_lab/test_scheduler_cache.py::test_allocated_bytes_refuses_a_fifo_without_waiting_for_a_writer"
  ]
