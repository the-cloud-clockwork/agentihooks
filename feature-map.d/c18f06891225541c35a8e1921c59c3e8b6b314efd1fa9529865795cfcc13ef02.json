    "tests/ci_lab/test_scheduler_required_frame.py::test_a_legacy_grade_derives_required_from_its_stored_gates",
    "tests/ci_lab/test_scheduler_required_frame.py::test_a_matching_frame_keeps_existing_grade_reuse_and_success",
    "tests/ci_lab/test_scheduler_required_frame.py::test_compaction_round_trips_the_stored_required_frame",
    "tests/ci_lab/test_scheduler_required_frame.py::test_relay_parses_the_frame_and_ignores_a_superseded_grade"
