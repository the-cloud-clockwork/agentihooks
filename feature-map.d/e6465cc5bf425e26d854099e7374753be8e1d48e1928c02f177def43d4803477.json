{
  "id": "herdr-native-resume",
  "origin": "inventory",
  "behaviour": "herdr native agent resume stays on: herdr configure never forces it off unless AGENTIHOOKS_HERDR_RESUME is off, releases the forced false of earlier releases once, and a routed non-swarm session in a herdr pane reports a resume command that reopens it through the agentihooks router while unrouted and swarm sessions keep herdr's own resume.",
  "seam": "scripts.herdr_setup apply_config and resume_off through configure; hooks.lifecycle.herdr_resume resume_argv, report and kick through the SessionStart handler",
  "tests": [
    "tests/test_herdr_setup.py::test_configure_keeps_agent_resume_the_operator_turned_on",
    "tests/test_herdr_setup.py::test_configure_releases_the_resume_off_it_wrote_before_once",
    "tests/test_herdr_setup.py::test_configure_keeps_a_resume_off_set_after_the_release",
    "tests/test_herdr_setup.py::test_configure_keeps_a_resume_off_sharing_its_section",
    "tests/test_herdr_setup.py::test_the_resume_switch_turns_agent_resume_off",
    "tests/test_herdr_setup.py::test_the_resume_switch_leaves_a_resume_off_config_alone",
    "tests/test_herdr_setup.py::test_resume_stays_on_unless_switched_off",
    "tests/test_herdr_setup.py::test_resume_stays_on_when_nothing_sets_the_switch",
    "tests/test_herdr_setup.py::test_the_resume_switch_is_read_from_the_agentihooks_env_file",
    "tests/test_herdr_resume.py::test_a_routed_claude_pane_resumes_through_the_router",
    "tests/test_herdr_resume.py::test_a_routed_pane_keeps_its_profile_home",
    "tests/test_herdr_resume.py::test_a_routed_codex_pane_resumes_through_the_router",
    "tests/test_herdr_resume.py::test_herdr_keeps_its_own_resume_when_agentihooks_has_nothing_to_add",
    "tests/test_herdr_resume.py::test_a_session_the_router_sent_to_the_api_or_a_login_resumes_through_it",
    "tests/test_herdr_resume.py::test_an_empty_session_id_reports_nothing",
    "tests/test_herdr_resume.py::test_a_start_without_a_session_id_never_calls_herdr",
    "tests/test_herdr_resume.py::test_an_empty_profile_home_is_left_out",
    "tests/test_herdr_resume.py::test_the_report_hands_herdr_the_routed_command_for_this_pane",
    "tests/test_herdr_resume.py::test_a_codex_session_reports_as_codex",
    "tests/test_herdr_resume.py::test_an_unrouted_session_never_calls_herdr",
    "tests/test_herdr_resume.py::test_a_refused_or_failed_report_is_logged_and_dropped",
    "tests/test_herdr_resume.py::test_failures_reach_the_agentihooks_log",
    "tests/test_herdr_resume.py::test_the_kick_detaches_the_report",
    "tests/test_herdr_resume.py::test_the_kick_forks_nothing_when_herdr_keeps_its_own_resume",
    "tests/test_hook_manager.py::test_session_start_reports_the_herdr_resume_command",
    "tests/test_hook_manager.py::test_a_failing_herdr_resume_report_never_breaks_session_start"
  ]
}
