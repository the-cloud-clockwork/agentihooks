# AgentiHooks — User Environment File
# =====================================
# This file is seeded to ~/.agentihooks/.env on first install.
# Values here OVERRIDE the shell session environment for hooks-utils and
# lifecycle hooks. Edit ~/.agentihooks/.env — never edit this file directly.
#
# Shell tip: to expose these vars to ALL MCP servers (not just hooks-utils),
# add the following to ~/.bashrc or ~/.zshrc:
#   [ -f ~/.agentihooks/.env ] && set -a && . ~/.agentihooks/.env && set +a

# =============================================================================
# RUNTIME DATA ROOT
# =============================================================================
# Override the default ~/.agentihooks directory (e.g. for K8s shared mounts).
# AGENTIHOOKS_HOME=/mnt/efs/shared

# =============================================================================
# HOOK LOGGING
# =============================================================================
# CLAUDE_HOOK_LOG_ENABLED=true
# CLAUDE_HOOK_LOG_FILE=~/.agentihooks/logs/hooks.log
# AGENT_LOG_FILE=~/.agentihooks/logs/agent.log
# LOG_HOOKS_COMMANDS=false
# LOG_TRANSCRIPT=true
# STREAM_AGENT_LOG=true
# LOG_USE_COLORS=true

# =============================================================================
# MEMORY
# =============================================================================
# MEMORY_AUTO_SAVE=true

# =============================================================================
# SECRETS SCANNING
# =============================================================================
# Controls how secrets scanning behaves: off | warn | standard | strict
# AGENTIHOOKS_SECRETS_MODE=standard

# =============================================================================
# MCP TOOL SERVER
# =============================================================================
# MCP_CATEGORIES=all
# ALLOWED_TOOLS=

# =============================================================================
# INTEGRATIONS
# =============================================================================

# --- GitHub ---
# App-based auth (preferred for orgs):
# GITHUB_APP_ID=
# GITHUB_INSTALLATION_ID=
# GITHUB_SECRET_ID=
# GITHUB_API_BASE=https://api.github.com
# Direct token auth:
# GITHUB_TOKEN=

# --- Confluence ---
# CONFLUENCE_SERVER_URL=https://your-org.atlassian.net
# CONFLUENCE_TOKEN=
# CONFLUENCE_SPACE_KEY=
# PARENT_PAGE_ID=

# --- Email (SMTP) ---
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SENDER_EMAIL=
# SMTP_SERVER_IP=   # optional fallback IP

# --- AWS (SQS, S3, Lambda, DynamoDB) ---
# AWS_REGION=us-east-1
# SQS_QUEUE_URL=
# STORAGE_URL=s3://your-bucket
# DYNAMODB_TABLE_NAME=
# DYNAMODB_PARTITION_KEY=session_id
# DYNAMODB_SORT_KEY=
# LAMBDA_FUNCTION_NAME=
# LAMBDA_INVOCATION_TYPE=RequestResponse

# --- Webhook ---
# WEBHOOK_URL=
# WEBHOOK_AUTH_HEADER=X-Auth-Token
# WEBHOOK_AUTH_TOKEN=
# WEBHOOK_TIMEOUT=30

# --- PostgreSQL ---
# POSTGRES_HOST=
# POSTGRES_NAME=
# POSTGRES_USERNAME=
# POSTGRES_PASSWORD=
# POSTGRES_PORT=5432
# POSTGRES_TABLE=

# --- Completions / Agent API ---
# AGENT_API_ENDPOINT=http://localhost:8000
# AGENT_API_KEY=
# AGENT_API_TIMEOUT=300

# =============================================================================
# TOKEN CONTROL
# =============================================================================
# Master switch — set false to disable all token control features
# TOKEN_CONTROL_ENABLED=true

# Context window monitor (StatusLine integration)
# TOKEN_MONITOR_ENABLED=true
# TOKEN_WARN_PCT=60
# TOKEN_CRITICAL_PCT=80
# TOKEN_REDIS_TTL=3600

# Bash output truncation (reduces verbose command output in context)
# BASH_FILTER_ENABLED=true
# BASH_FILTER_MAX_LINES=50
# BASH_FILTER_MAX_CHARS=5000
# BASH_FILTER_TEST_MAX_FAILURES=10
# BASH_FILTER_GIT_MAX_COMMITS=20

# File read deduplication (blocks redundant re-reads within a session)
# FILE_READ_CACHE_ENABLED=true
# FILE_READ_CACHE_BACKEND=redis
# FILE_READ_CACHE_TTL=21600

# MCP hygiene reminder at session start
# MCP_HYGIENE_ENABLED=true

# =============================================================================
# CONSOLE QUOTA DISPLAY  (opt-in — requires scripts/claude_usage_watcher.py)
# =============================================================================
# Path where the watcher writes quota JSON (and statusline reads it from)
# CLAUDE_USAGE_FILE=~/.agentihooks/claude_usage.json
# Seconds before data is considered stale (default: 5 minutes)
# CLAUDE_USAGE_STALE_SEC=300
# Watcher poll interval in seconds (default: 60)
# CLAUDE_USAGE_POLL_SEC=60

# =============================================================================
# BROADCAST SYSTEM — fleet messaging
# =============================================================================
# Severity tiers:
#   info      → once per session (deduped via delivered_to)
#   alert     → every UserPromptSubmit (persistent, ack-only)
#   critical  → every UserPromptSubmit + every PreToolUse (when enabled below)
#
# Defaults (changed 2026-05-05):
#   BROADCAST_CRITICAL_ON_PRETOOL=false   (was true) — gate alerts off PreToolUse
#   BROADCAST_PRETOOL_MIN_SEVERITY=critical (was alert) — only emergencies fire on tool calls
# These defaults reduce hook-error contamination per Claude Code issue #34713.
# Operators on incident response can opt back in:
# BROADCAST_CRITICAL_ON_PRETOOL=true
# BROADCAST_PRETOOL_MIN_SEVERITY=alert
#
# Per-injection byte caps. 0 (default) = no cap — full content ships through
# whatever stdout the hook emits. Set >0 to opt in to truncation when you
# need envelope headroom under Claude Code's 10,000-char hook output limit
# (over → harness silently writes to a temp file and the model receives a
# filepath instead of the body).
#
# Recommended values when you opt in:
#   BROADCAST_MAX_BYTES_PRETOOL=4096   — keeps PreToolUse alerts under 4 KB
#   BROADCAST_MAX_BYTES_PROMPT=8192    — keeps banner injects under 8 KB
#   CI_MANIFESTO_MAX_BYTES=7500        — caps CI manifesto inject + adds a
#                                         "Read full doctrine at <path>" footer
#
# To see what each event currently emits and whether anything is over the
# 10K Claude Code cap:  agentihooks doctor --debug-hook
# BROADCAST_MAX_BYTES_PRETOOL=0
# BROADCAST_MAX_BYTES_PROMPT=0
# CI_MANIFESTO_MAX_BYTES=0

# =============================================================================
# HOOKS-UTILS MCP TRANSPORT
# =============================================================================
#
# Leave all of this alone unless Claude Code refuses to load stdio MCP servers.
# Some enterprise policies filter every stdio-transport server out of the client
# at load time — the server is never spawned, its tools never appear, and there
# is no error. On such a machine hooks-utils is simply absent.
#
# Setting MCP_TRANSPORT to a network transport makes Claude Code CONNECT to a
# persistent daemon instead of spawning one per session. Turn it on with:
#
#     echo 'MCP_TRANSPORT=sse' >> ~/.agentihooks/.env
#     agentihooks init
#
# init starts the daemon itself — under systemd where a user bus exists, as a
# detached child with a pidfile everywhere else (WSL2 without systemd=true,
# containers, macOS). Drive it by hand with:
#
#     agentihooks mcp status | start | stop | restart
#
# `status` reports the configured transport against what is actually running and
# names every mismatch. Exit 0 running and matching, 1 stopped, 2 diverged.
#
# Two things to know before enabling:
#   - One daemon serves every session, so MCP_CATEGORIES becomes machine-wide.
#     Per-profile tool subsetting is stdio-only.
#   - Neither transport carries authentication. The loopback bind IS the
#     security boundary — any local process that reaches the port can call every
#     tool. Do not widen MCP_HOST without putting a gate in front of it.
#
# MCP_TRANSPORT=stdio                  # stdio (default) | sse | streamable-http
# MCP_HOST=localhost                   # bind address AND the host in the client url
# MCP_PORT=8642
# MCP_SCHEME=http                      # https only behind a TLS reverse proxy
# MCP_SSE_PATH=/sse
# MCP_STREAMABLE_HTTP_PATH=/mcp
# MCP_STATELESS_HTTP=false             # only for a non-sticky reverse proxy
# AGENTIHOOKS_MCP_SUPERVISOR=auto      # auto | systemd | pidfile
# MCP_SESSION_ID_BANNER_ENABLED=true   # tell each session its own id at start
#
# Spell MCP_HOST `localhost`, not 127.0.0.1. Both are loopback and the security
# boundary is identical, but an enterprise policy was observed dropping a
# dotted-quad entry from the client's server list outright — absent from
# `claude mcp list`, and `claude mcp get` reporting it as not configured.

# ── Brain (agentibrain-kernel) ────────────────────────────────────────────────
# You normally set NONE of this. agentihooks reads the brain's own config file
# — $AGENTIBRAIN_HOME/.env, default ~/.agentibrain/.env, the same file that
# feeds its docker compose — and adopts BRAIN_URL and KB_ROUTER_TOKEN from it.
# One copy of the bearer, so a rotation cannot go stale here.
#
# Only the connection keys are adopted; that file's POSTGRES_PASSWORD,
# MINIO_ROOT_PASSWORD and provider keys never enter a session's environment.
#
# Set something below only to override the brain's own answer — an explicit
# value here outranks discovery, and the process environment outranks both.
# For a brain running elsewhere, edit ~/.agentibrain/.env instead.
#
# BRAIN_URL=http://127.0.0.1:8103
# BRAIN_HTTP_TOKEN=                    # falls back to KB_ROUTER_TOKEN
# BRAIN_ENABLED=true                   # inject hot arcs + signals each prompt
# BRAIN_WRITER_ENABLED=true            # POST @lesson/@signal/@decision/@milestone markers
#
# Markers POST to {BRAIN_URL}/marker on session Stop. With BRAIN_URL unset (or
# brain-api down) they buffer in ~/.agentihooks/brain-outbox; the buffer drains
# on the next session Stop after brain-api is reachable again.
