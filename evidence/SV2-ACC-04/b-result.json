  "state_assertions": {
    "scope": "Claim, acknowledge and publish through another fleet's FleetBroadcasts with this fleet's grant are refused forbidden_scope; a wildcard channel claim returns nothing and writes no delivery record",
    "personal": "The personal brain message is never delivered to a swarm seat and has no delivery record or lag",
    "foreign_record": "A canonical record planted with another fleet's name is never delivered",
    "agent_grant": "An agent grant cannot publish critical or nuclear severity, outside its project, or to the personal brain",
    "authentication": "Empty or forged operator credentials, an operator callback naming nobody and a launch grant offered as an operator credential are refused unauthenticated",
    "ownership": "A broadcast id stays with the publisher and brain that first used it: another seat, the operator or another brain is refused forbidden_scope, while the same seat's next generation may revise it. An operation id replays only for its own publisher; a replay with other content or another explicit id is refused invalid_request",
    "drafts": "Twenty one malformed drafts are refused invalid_request",
    "no_mutation": "A snapshot of every broadcast key is identical before and after each refusal"
  },
  "disclosure_assertion": "Refusals carry only an error class (forbidden_scope, unauthenticated, invalid_request here; distribution_disabled, stale_generation, stale_revision, not_delivered and dependency_unavailable elsewhere in the module); no token, grant or message content",
  "recovery_isolation": "A corrected draft must be a new publish under a valid grant or operator credential; no refusal falls back to a privileged path",
  "cleanup": "fakeredis per test; no live resource mutations",
