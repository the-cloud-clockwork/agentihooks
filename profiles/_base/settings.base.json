{
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "Task(*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "cd /app && __PYTHON__ -m hooks.statusline"
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_TOOL_SEARCH": "auto:5"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /app && __PYTHON__ -m hooks"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON__ /app/scripts/swarm_ledger/ledger_hook.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /app && __PYTHON__ -m hooks"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /app && __PYTHON__ -m hooks"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /app && __PYTHON__ -m hooks"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON__ /app/scripts/swarm_ledger/ledger_hook.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /app && __PYTHON__ -m hooks"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON__ /app/scripts/swarm_ledger/ledger_hook.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /app && __PYTHON__ -m hooks"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /app && __PYTHON__ -m hooks"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /app && __PYTHON__ -m hooks"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON__ /app/scripts/swarm_ledger/ledger_hook.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /app && __PYTHON__ -m hooks"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /app && __PYTHON__ -m hooks"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /app && __PYTHON__ -m hooks"
          }
        ]
      }
    ]
  }
}
