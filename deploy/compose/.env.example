# Copy to .env next to compose.yaml.
AGENTIHOOKS_DEPLOYMENT=compose
# Select one shared Postgres and Redis for every ledger server and swarm engine.
# AGENTIHOOKS_SWARM_DATABASE_URL=
# AGENTIHOOKS_SWARM_REDIS_URL=
# Password of the swarm Redis admin user; each hive member gets its own ACL user.
SWARM_REDIS_PASSWORD=
# Address the ledger, Redis and hive endpoint ports listen on; set a private interface to reach them from other hosts.
SWARM_BIND=127.0.0.1
# The ledger answers only the host names it knows: set the address other hosts use, or list extra host:port names.
# SWARM_PUBLIC_URL=http://swarm.example.internal:8765
# SWARM_ALLOWED_HOSTS=swarm.example.internal:8765
SWARM_HIVE_ID=compose-controller
# cert.pem, key.pem and ca.pem live here; the hive endpoint (--profile join) always needs them.
SWARM_TLS_DIR=./deploy/compose/tls
# Redis TLS: set both lines together.
# SWARM_REDIS_SCHEME=rediss
# SWARM_CA_FILE=/tls/ca.pem
# Redis URL handed to joining hive members, as they reach it.
# SWARM_MEMBER_REDIS_URL=rediss://swarm.example.internal:6379/0
# Swarm image tag; agentihooks swarm init writes release.
# SWARM_IMAGE_TAG=dev
