server {
    listen 127.0.0.1:${LEDGER_PORT};
    client_max_body_size 64m;
    location / {
        set $upstream ${LEDGER_SCHEME}://127.0.0.1:${LEDGER_READ_PORT};
        if ($request_method !~ ^(GET|HEAD)$) {
            set $upstream ${LEDGER_SCHEME}://127.0.0.1:${LEDGER_API_PORT};
        }
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
